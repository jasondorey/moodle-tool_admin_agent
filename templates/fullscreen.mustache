<div class="tool-adminagent-fullscreen-host" data-region="fullscreen-host">
    <p class="text-muted">{{#str}} splitviewtip, tool_adminagent, {{wwwroot}} {{/str}}</p>
    {{#react}}
    {
        "component": "@moodle/lms/tool_adminagent/ChatApp",
        "props": {
            "path": {{{pathjson}}},
            "placementid": {{placementid}},
            "location": "fullscreen",
            "firstname": {{{firstnamejson}}},
            "startlayout": "fullscreen"
        },
        "class": "tool-adminagent-react-mount"
    }
    <p class="text-muted small">{{#str}} errornojs, tool_adminagent {{/str}}</p>
    {{/react}}
</div>
