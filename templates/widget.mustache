<div id="tool-adminagent-root" class="tool-adminagent-root tool-adminagent-loc-{{location}}" data-location="{{location}}">
    {{#floating}}
    <button type="button" class="btn btn-icon rounded-circle bg-primary text-white tool-adminagent-fab" data-action="open-chat" title="{{#str}} pluginname, tool_adminagent {{/str}}">
        {{#pix}}comment-nodes, tool_adminagent, {{#str}}pluginname, tool_adminagent{{/str}}{{/pix}}
    </button>
    {{/floating}}
    {{^floating}}
    <button type="button" class="btn btn-sm btn-primary tool-adminagent-heading-btn d-none" data-action="open-chat" title="{{#str}} pluginname, tool_adminagent {{/str}}">
        {{#str}} pluginname, tool_adminagent {{/str}}
    </button>
    {{/floating}}
    {{#react}}
    {
        "component": "@moodle/lms/tool_adminagent/ChatApp",
        "props": {
            "path": {{{pathjson}}},
            "placementid": {{placementid}},
            "location": "{{location}}",
            "firstname": {{{firstnamejson}}},
            "startlayout": "{{startlayout}}"
        },
        "class": "tool-adminagent-react-mount"
    }
    <p class="text-muted small">{{#str}} errornojs, tool_adminagent {{/str}}</p>
    {{/react}}
</div>
